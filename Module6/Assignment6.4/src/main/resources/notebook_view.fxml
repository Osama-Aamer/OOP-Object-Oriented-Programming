<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.NoteController"
            prefHeight="500.0" prefWidth="600.0">

    <!-- Top: Application Title -->
    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #3498db;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
            </padding>
            <Label text="📓 My Notebook" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Left: Notes List (ListView for extra points) -->
    <left>
        <VBox prefWidth="200.0" spacing="10.0" style="-fx-background-color: #ecf0f1;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Saved Notes:">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
            </Label>
            <ListView fx:id="notesListView" prefHeight="350.0" prefWidth="180.0"/>
        </VBox>
    </left>

    <!-- Center: Note Input Form -->
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- Title Input -->
            <VBox spacing="5.0">
                <Label text="Title:">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
                <TextField fx:id="titleField" promptText="Enter note title..."/>
            </VBox>

            <!-- Content Input -->
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Label text="Content:">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
                <TextArea fx:id="contentArea" prefHeight="200.0" promptText="Write your note here..." wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="10.0">
                <Button fx:id="addButton" text="Add" onAction="#handleAddNote"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="80.0"/>
                <Button fx:id="updateButton" text="Update" onAction="#handleUpdateNote"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="80.0"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDeleteNote"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="80.0"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>

